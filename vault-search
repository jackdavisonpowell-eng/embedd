#!/usr/bin/env python3
"""vault-search - ask the central vault index a question, get the passages back.

  vault-search "when did the P100 fan die?"
  vault-search -k 10 "gsu schedule"
  vault-search --path College/ "what is due this week"
  vault-search --json "..."          machine-readable, for agents
  vault-search --health              is the index up, how fresh is it

No model runs here. This is a thin client for the embedd service on thebeast,
which holds the one index every agent shares.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

# First reachable wins: whatever you set, then this box, then the host named in
# ~/.config/vault-search/url (one line, e.g. http://<host-or-tailscale-ip>:11475).
CONF = os.path.expanduser("~/.config/vault-search/url")


def _configured():
    try:
        with open(CONF) as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        return []


CANDIDATES = [u for u in [os.environ.get("VAULT_EMBED_URL"),
                          "http://127.0.0.1:11475",
                          *_configured()] if u]


def call(path, payload=None, timeout=30):
    last = None
    for base in CANDIDATES:
        try:
            data = json.dumps(payload).encode() if payload is not None else None
            req = urllib.request.Request(base + path, data=data,
                                         headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.load(r), base
        except (urllib.error.URLError, OSError, TimeoutError) as e:
            last = e
            continue
    sys.exit(f"vault-search: no index reachable ({last}). Tried: {', '.join(CANDIDATES)}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("query", nargs="*")
    ap.add_argument("-k", type=int, default=6, help="how many passages")
    ap.add_argument("--path", default="", help="only notes under this path prefix")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--full", action="store_true", help="whole chunk, not a snippet")
    ap.add_argument("--health", action="store_true")
    a = ap.parse_args()

    if a.health:
        out, base = call("/health")
        print(json.dumps({**out, "server": base}, indent=1))
        return

    q = " ".join(a.query).strip()
    if not q:
        ap.error("nothing to search for")
    out, _ = call("/search", {"q": q, "k": a.k, "path": a.path}, timeout=60)
    if "error" in out:
        sys.exit(f"vault-search: {out['error']}")
    hits = out.get("hits", [])
    if a.json:
        print(json.dumps(hits, indent=1))
        return
    if not hits:
        print("nothing in the vault about that.")
        return
    for h in hits:
        head = f"  # {h['heading']}" if h["heading"] else ""
        print(f"\n[{h['score']:.3f}] {h['path']}{head}")
        t = h["text"] if a.full else h["text"][:400].replace("\n", " ")
        print("   " + t)


if __name__ == "__main__":
    main()
